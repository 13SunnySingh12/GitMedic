# Copy to ml-service/.env and fill in. Placeholders only — never commit real values.
# Local Docker DB (docker compose up -d db): postgresql://gitmedic_ml:<pw>@localhost:5433/gitmedic
ML_DB_DSN=postgresql://gitmedic_ml:<change-me>@<pooler-host>:5432/postgres?sslmode=require
INTERNAL_API_TOKEN=<same-as-backend>
MODEL_DIR=./data/models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DUPLICATE_THRESHOLD=0.80
DUPLICATE_TOP_K=5
LLM_ENABLED=false
LLM_PROVIDER=groq
LLM_MODEL=<verify-in-groq-console>
GROQ_API_KEY=<optional>
LLM_TIMEOUT_SECONDS=20
